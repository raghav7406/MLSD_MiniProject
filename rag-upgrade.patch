+"""Tests for hybrid (BM25 + embeddings + RRF) retrieval.
+
+These run offline: a tiny FakeEmbedder maps synonym groups onto shared vector
+dimensions, which is enough to exercise fusion, persistence, fallback and
+idempotency. They do NOT measure the quality of the real embedding model; use
+`python -m eval.evaluate_rag` for that.
+"""
+import json
+import logging
+
+import numpy as np
+import pytest
+
+from src.ingestion.chunker import Chunk, load_documents
+from src.ingestion.ingest_pipeline import ingest
+from src.ingestion.vector_store import VectorStore
+
+CONCEPTS = [
+    {"cataract", "eye", "lens", "phacoemulsification", "ophthalmic"},
+    {"waiting", "wait", "period", "delay", "months"},
+    {"room", "rent", "ward", "bed", "icu"},
+    {"cosmetic", "aesthetic", "excluded", "exclusion"},
+]
+
+
+class FakeEmbedder:
+    """Bag-of-concepts embedder: words in the same group share a dimension."""
+
+    def __init__(self, name: str = "fake-concepts-v1") -> None:
+        self.name = name
+
+    def _vec(self, text: str) -> np.ndarray:
+        words = text.lower().replace(".", " ").split()
+        v = np.array([sum(w in group for w in words) for group in CONCEPTS], dtype=np.float32)
+        norm = np.linalg.norm(v)
+        return v / norm if norm else v
+
+    def embed_passages(self, texts):
+        return np.stack([self._vec(t) for t in texts])
+
+    def embed_query(self, text):
+        return self._vec(text)
+
+
+CHUNKS = [
+    Chunk("Cataract surgery is covered only after a 24 month waiting period.", "p.txt", clause_id="Code-Excl02"),
+    Chunk("Room rent is limited to one percent of the sum insured per day.", "p.txt", clause_id="7.1"),
+    Chunk("Cosmetic procedures are permanently excluded from cover.", "p.txt", clause_id="6.1"),
+    Chunk("Clause Code-Excl07 sets the rules for hernia repair.", "p.txt", clause_id="Code-Excl07"),
+]
+
+
+@pytest.fixture
+def store(tmp_path):
+    s = VectorStore(tmp_path / "store.json", embedder=FakeEmbedder())
+    s.add_chunks(CHUNKS, FakeEmbedder())
+    return s
+
+
+class TestHybridSearch:
+    def test_semantic_match_with_no_shared_keywords(self, store):
+        query = "operation on the eye lens"  # shares no word with the cataract chunk
+        assert store.search(query, top_k=3, mode="lexical") == []
+        for mode in ("dense", "hybrid", None):
+            top = store.search(query, top_k=1, mode=mode)
+            assert top and "Cataract" in top[0].text
+
+    def test_exact_identifier_still_found_via_keywords(self, store):
+        # Embeddings know nothing about "Code-Excl07"; BM25 must carry it in the fused ranking.
+        top = store.search("Code-Excl07", top_k=1)
+        assert top and top[0].clause_id == "Code-Excl07"
+
+    def test_results_carry_descending_scores(self, store):
+        results = store.search("waiting period for eye surgery", top_k=4)
+        scores = [r.score for r in results]
+        assert scores and all(s > 0 for s in scores)
+        assert scores == sorted(scores, reverse=True)
+
+    def test_min_similarity_filters_weak_dense_hits(self, tmp_path):
+        s = VectorStore(tmp_path / "s.json", embedder=FakeEmbedder(), min_similarity=0.999)
+        s.add_chunks(CHUNKS, FakeEmbedder())
+        assert s.search("operation on the eye lens", mode="dense") == []
+
+    def test_dense_mode_without_embeddings_is_an_error(self, tmp_path):
+        s = VectorStore(tmp_path / "s.json")
+        s.add_chunks(CHUNKS)  # no embedder -> keyword-only store
+        assert s.retrieval_mode == "lexical"
+        assert s.search("cataract waiting period")  # auto mode degrades gracefully
+        with pytest.raises(ValueError):
+            s.search("cataract", mode="dense")
+
+
+class TestPersistenceAndFallback:
+    def test_embeddings_survive_persist_and_reload(self, store):
+        store.persist()
+        raw = json.loads(store.path.read_text(encoding="utf-8"))
+        assert all(r["embedding_model"] == "fake-concepts-v1" and r["embedding"] for r in raw)
+
+        reloaded = VectorStore(store.path, embedder=FakeEmbedder())
+        assert reloaded.retrieval_mode == "hybrid"
+        assert "Cataract" in reloaded.search("operation on the eye lens", top_k=1)[0].text
+
+    def test_model_mismatch_falls_back_to_lexical(self, store, caplog):
+        store.persist()
+        with caplog.at_level(logging.WARNING):
+            other = VectorStore(store.path, embedder=FakeEmbedder(name="some-other-model"))
+            assert other.retrieval_mode == "lexical"
+        assert "Re-run ingestion" in caplog.text
+
+    def test_clause_lookup_is_unchanged(self, store):
+        assert [c.clause_id for c in store.lookup_clause("Code-Excl02")] == ["Code-Excl02"]
+
+
+class TestIngestion:
+    def _corpus(self, tmp_path):
+        d = tmp_path / "corpus"
+        d.mkdir()
+        (d / "policy.txt").write_text("Cataract surgery has a waiting period.\n\nRoom rent is limited.")
+        return d
+
+    def test_ingest_embeds_and_records_model(self, tmp_path):
+        d = self._corpus(tmp_path)
+        n = ingest(str(d), str(tmp_path / "s.json"), str(tmp_path / "m.json"), force=True, embedder=FakeEmbedder())
+        manifest = json.loads((tmp_path / "m.json").read_text())
+        assert n >= 1
+        assert manifest["embedding_version"] == "fake-concepts-v1"
+        assert manifest["retrieval_mode"] == "hybrid"
+
+    def test_changing_the_model_triggers_a_rebuild(self, tmp_path):
+        d = self._corpus(tmp_path)
+        args = (str(d), str(tmp_path / "s.json"), str(tmp_path / "m.json"))
+        ingest(*args, force=True, embedder=FakeEmbedder("fake-concepts-v1"))
+        ingest(*args, force=False, embedder=FakeEmbedder("fake-concepts-v1"))  # unchanged -> skipped
+        ingest(*args, force=False, embedder=FakeEmbedder("fake-concepts-v2"))  # model changed -> rebuilt
+        manifest = json.loads((tmp_path / "m.json").read_text())
+        assert manifest["embedding_version"] == "fake-concepts-v2"
+        stored = json.loads((tmp_path / "s.json").read_text())
+        assert {r["embedding_model"] for r in stored} == {"fake-concepts-v2"}
+
+    def test_front_matter_is_not_indexed(self):
+        chunks = load_documents("data/corpus")
+        assert chunks
+        assert not any("table of contents" in c.text.lower() for c in chunks)
+
+
+def test_corpus_search_tool_reports_scores(reset_tools):
+    from src.agents.tools import corpus_search
+
+    results = corpus_search("cataract surgery waiting period", top_k=3)
