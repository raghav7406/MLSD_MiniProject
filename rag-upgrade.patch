diff --git a/src/ingestion/embedder.py b/src/ingestion/embedder.py
new file mode 100644
index 0000000..d090121
--- /dev/null
+++ b/src/ingestion/embedder.py
@@ -0,0 +1,92 @@
+"""Embedding backends for semantic retrieval.
+
+The default backend is fastembed (ONNX runtime, no PyTorch) running
+BAAI/bge-small-en-v1.5 locally, so no API key or network call is needed at
+query time once the model weights are cached.
+
+Environment variables
+---------------------
+RAG_EMBEDDING_BACKEND   fastembed (default) | none   ("none" = keyword/BM25 only)
+RAG_EMBEDDING_MODEL     any fastembed text model (default BAAI/bge-small-en-v1.5)
+FASTEMBED_CACHE_PATH    where the model weights are cached
+"""
+from __future__ import annotations
+
+import logging
+import os
+from functools import lru_cache
+from typing import Protocol, Sequence
+
+import numpy as np
+
+log = logging.getLogger(__name__)
+
+DEFAULT_MODEL = "BAAI/bge-small-en-v1.5"
+
+# BGE models retrieve noticeably better when short queries carry this instruction
+# (passages are embedded as-is).
+BGE_QUERY_PREFIX = "Represent this sentence for searching relevant passages: "
+
+
+class Embedder(Protocol):
+    """Anything that can turn text into unit-length vectors."""
+
+    name: str
+
+    def embed_passages(self, texts: Sequence[str]) -> np.ndarray: ...
+
+    def embed_query(self, text: str) -> np.ndarray: ...
+
+
+def _normalise(vectors: np.ndarray) -> np.ndarray:
+    norms = np.linalg.norm(vectors, axis=1, keepdims=True)
+    return vectors / np.clip(norms, 1e-12, None)
+
+
+class FastEmbedEmbedder:
+    def __init__(self, model_name: str = DEFAULT_MODEL, cache_dir: str | None = None) -> None:
+        from fastembed import TextEmbedding  # lazy: only needed when embeddings are on
+
+        self.name = model_name
+        self._model = TextEmbedding(model_name=model_name, cache_dir=cache_dir)
+        self._query_prefix = BGE_QUERY_PREFIX if "bge" in model_name.lower() else ""
+
+    def _embed(self, texts: Sequence[str]) -> np.ndarray:
+        return _normalise(np.asarray(list(self._model.embed(list(texts))), dtype=np.float32))
+
+    def embed_passages(self, texts: Sequence[str]) -> np.ndarray:
+        return self._embed(texts)
+
+    def embed_query(self, text: str) -> np.ndarray:
+        return self._embed([self._query_prefix + text])[0]
+
+
+@lru_cache(maxsize=4)
+def _load(model_name: str, cache_dir: str | None) -> FastEmbedEmbedder:
+    return FastEmbedEmbedder(model_name, cache_dir)
+
+
+def get_embedder(strict: bool = False) -> Embedder | None:
+    """Return the configured embedder, or None when semantic retrieval is off.
+
+    strict=True is for ingestion: if embeddings were requested but the model
+    cannot be loaded, raise instead of quietly building a keyword-only index.
+    At query time (strict=False) we log a warning and degrade to BM25 so the
+    service stays up.
+    """
+    backend = os.getenv("RAG_EMBEDDING_BACKEND", "fastembed").strip().lower()
+    if backend in {"none", "off", "lexical", "bm25"}:
+        return None
+    if backend != "fastembed":
+        raise ValueError(f"Unknown RAG_EMBEDDING_BACKEND={backend!r} (use 'fastembed' or 'none')")
+    model = os.getenv("RAG_EMBEDDING_MODEL", DEFAULT_MODEL)
+    try:
+        return _load(model, os.getenv("FASTEMBED_CACHE_PATH") or None)
+    except Exception as exc:  # network down, model missing, fastembed not installed...
+        if strict:
+            raise RuntimeError(
+                f"Could not load embedding model {model!r}: {exc}. "
+                "Fix the cause, or set RAG_EMBEDDING_BACKEND=none to build a keyword-only index."
+            ) from exc
+        log.warning("Embedding model %r unavailable (%s); falling back to BM25-only retrieval", model, exc)
+        return None
