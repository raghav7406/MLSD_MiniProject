+"""Hybrid retrieval store: dense embeddings + BM25, merged with Reciprocal Rank Fusion.
+
+Why hybrid rather than embeddings alone: policy text is full of exact
+identifiers ("Code-Excl02", "Section 5") that embedding models blur together,
+while keyword search is blind to paraphrases ("eye lens operation" vs
+"cataract surgery"). Fusing both rankings gets the strengths of each.
+
+Retrieval modes
+---------------
+hybrid   dense + BM25 fused with RRF          (default when the store has embeddings)
+dense    embeddings only
+lexical  BM25 only                            (automatic fallback, no model needed)
+"""
+from __future__ import annotations
+
 import json
+import logging
+import math
+import os
 import re
+from collections import Counter
 from pathlib import Path
 from typing import Iterable
 
+import numpy as np
+
 from .chunker import Chunk
+from .embedder import Embedder, get_embedder
+
+log = logging.getLogger(__name__)
 
+RRF_K = 60                   # standard Reciprocal Rank Fusion constant
+BM25_K1, BM25_B = 1.5, 0.75  # standard BM25 parameters
 
-def _tokens(text: str) -> set[str]:
-    return set(re.findall(r"[a-z0-9][a-z0-9-]+", text.lower()))
