GEMINI_API_KEY=
REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=false
VECTOR_STORE_PATH=data/vector_store.json
QUARANTINE_PATH=data/quarantine_records.json
RESULT_STORE_PATH=data/results.json
FEEDBACK_PATH=data/feedback.json
API_BASE_URL=http://localhost:8000

# Agent Framework & Retrieval
AGENT_RUNTIME=legacy
SEMANTIC_RETRIEVAL_ENABLED=false
EMBEDDING_MODEL=local-tfidf-semantic-v1
VECTOR_INDEX_PATH=data/semantic_index

# OpenTelemetry & Jaeger Tracing
OTEL_ENABLED=false
OTEL_SERVICE_NAME=preauth-api
OTEL_WORKER_SERVICE_NAME=preauth-worker
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
